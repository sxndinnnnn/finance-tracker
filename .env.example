# --- Database ---
DATABASE_URL=postgresql+asyncpg://finance:finance@localhost:5432/finance_tracker

# --- Auth ---
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Email (reminder alerts) ---
EMAIL_PROVIDER=smtp        # smtp | sendgrid | resend
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=alerts@yourapp.com
SENDGRID_API_KEY=
RESEND_API_KEY=

# --- Reminder job ---
REMINDER_CHECK_HOUR_UTC=8          # what hour the daily reminder sweep runs
DEFAULT_REMINDER_DAYS_BEFORE=3     # fallback if a user hasn't set their own

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
