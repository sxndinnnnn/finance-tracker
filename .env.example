# --- Database ---
# Paste a managed provider's connection string (Supabase, RDS, ...) as-is —
# postgres:// or postgresql:// both get rewritten to postgresql+asyncpg://
# automatically. Which connection to use depends on how this process runs:
#   - Local dev, or any persistent process (uvicorn running continuously):
#     use the direct connection (port 5432). Leave DB_DISABLE_PREPARED_STATEMENT_CACHE=false.
#   - Deployed on Vercel (serverless — see backend/vercel.json): use
#     Supabase's Supavisor transaction-mode pooler (port 6543) instead, and
#     set DB_DISABLE_PREPARED_STATEMENT_CACHE=true. Run migrations (alembic
#     upgrade head) against the direct connection separately, not the pooler.
DATABASE_URL=postgresql+asyncpg://finance:finance@localhost:5432/finance_tracker
DB_SSL_REQUIRE=false               # true for Supabase/RDS/etc.; false for local Postgres
DB_DISABLE_PREPARED_STATEMENT_CACHE=false  # true only when DATABASE_URL is a pgbouncer/Supavisor pooler

# --- Auth ---
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=*                     # comma-separated origins in production, e.g. https://your-app.vercel.app

# --- Email (reminder alerts) ---
EMAIL_PROVIDER=smtp        # smtp | sendgrid | resend
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=alerts@yourapp.com
SENDGRID_API_KEY=
RESEND_API_KEY=

# --- Reminder job ---
REMINDER_CHECK_HOUR_UTC=8          # what hour the daily reminder sweep runs — keep in sync with
                                    # the cron schedule in backend/vercel.json if you change this
DEFAULT_REMINDER_DAYS_BEFORE=3     # fallback if a user hasn't set their own
ENABLE_IN_PROCESS_SCHEDULER=true   # false on Vercel — reminders run via Vercel Cron hitting
                                    # /api/v1/cron/reminder-sweep instead; true for local dev and
                                    # any persistent-process deployment (uvicorn running continuously)
CRON_SECRET=                       # required in production when ENABLE_IN_PROCESS_SCHEDULER=false —
                                    # Vercel sends this as `Authorization: Bearer $CRON_SECRET`
                                    # automatically when set on the Vercel project. Leave blank locally.

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
